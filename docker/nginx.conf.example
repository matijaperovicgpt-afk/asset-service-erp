# Example nginx site for the ERP (host-level nginx in front
# of docker-compose.prod.yml). Adjust server_name, certificate paths and
# the media alias to your deployment.
#
# The /internal-media/ location implements the POR-04 upgrade path: with
# MEDIA_ACCEL_REDIRECT=True Django answers media requests with an
# X-Accel-Redirect header after its auth check, and nginx streams the
# file from disk. Mount the compose media volume (or bind the same path)
# so nginx can read it.

server {
    listen 80;
    server_name service.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name service.example.com;

    ssl_certificate     /etc/letsencrypt/live/service.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/service.example.com/privkey.pem;

    # Portal uploads: up to 5 files per report, videos up to 50 MB each
    # (attachments app caps any single file at 50 MB) - one multipart
    # body can approach 250 MB.
    client_max_body_size 260m;

    location /static/ {
        # whitenoise also serves these; an alias saves the app a trip.
        # Point at the static_data volume mountpoint on the host.
        alias /srv/erp/staticfiles/;
        expires 30d;
    }

    location /internal-media/ {
        internal;
        alias /srv/erp/media/;
    }

    # No /ws/ upgrade block on purpose: background jobs run over Redis,
    # not WebSockets, and Channels is not part of this deployment. Do not
    # copy one in from the roadmap without also adding an ASGI server.

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
