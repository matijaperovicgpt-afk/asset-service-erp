# nginx site for an INTERNAL-ONLY deployment (PORTAL_ENABLED=False): the
# app lives on a box on the office LAN, staff reach it there or over the
# office VPN, and nothing is published to the internet. Companion to
# nginx.conf.example, which assumes a public hostname and Let's Encrypt.
#
# TLS is still required - config/settings/prod.py hard-codes Secure
# cookies, so over plain http:// nobody can sign in. With no public name
# there is no CA to ask, so the box signs its own certificate. Once, on
# the box (10 years; SAN carries the IP and hostname staff will type):
#
#   sudo mkdir -p /etc/nginx/tls && sudo openssl req -x509 -nodes -newkey rsa:2048 \
#     -days 3650 -keyout /etc/nginx/tls/erp.key -out /etc/nginx/tls/erp.crt \
#     -subj "/CN=erp.internal.example" \
#     -addext "subjectAltName=IP:192.0.2.10,DNS:erp.internal.example"
#
# Every staff browser warns once about the untrusted issuer; "proceed"
# is fine on a LAN, or install erp.crt in each machine's trust store
# to silence it. Either way keep DJANGO_SECURE_HSTS_SECONDS=0 in .env:
# HSTS removes the "proceed" button, and the first visitor would lock
# their browser out of the app for the whole HSTS window.

server {
    listen 80;
    server_name 192.0.2.10 erp.internal.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name 192.0.2.10 erp.internal.example;

    ssl_certificate     /etc/nginx/tls/erp.crt;
    ssl_certificate_key /etc/nginx/tls/erp.key;

    # Staff attach photos and videos to cases from the backoffice: the
    # attachments app caps any single file at 50 MB, and a multi-file
    # upload can approach 250 MB.
    client_max_body_size 260m;

    location /static/ {
        # whitenoise also serves these; an alias saves the app a trip.
        # Point at the static_data volume mountpoint on the host.
        alias /srv/erp/staticfiles/;
        expires 30d;
    }

    location /internal-media/ {
        internal;
        alias /srv/erp/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
