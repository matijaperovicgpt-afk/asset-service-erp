# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Branding and locale
# Product name shown in the header, page titles, footer and admin.
SITE_NAME=Service Desk
# Default UI language for every visitor: "en" or "sr-latn".
LANGUAGE_CODE=en
# Wall-clock zone for opening hours and scheduling (IANA name).
TIME_ZONE=UTC
# Named locations offered by the location pickers, comma-separated.
LOCATION_CHOICES=Main workshop,Customer site
# Storage packages run one season from this day (MM-DD) to the same day next year.
STORAGE_SEASON_START=01-01
# Domestic dialling code (digits, no "+") used when matching client phone numbers.
PHONE_COUNTRY_CODE=44
# Longest asset (metres) the own transport vehicle may carry; longer needs an external carrier.
TRANSPORT_OWN_VEHICLE_MAX_LENGTH_M=10

# Client-facing portal (apps.portal): the anonymous fault report at "/"
# and its thank-you page. There is no tracking page in either mode - the
# client is kept informed by e-mail/phone. False = an internal-only
# deployment: neither URL exists and "/" goes straight to the sign-in
# page. Staff enter every case themselves (e.g. from a form on the
# public website).
PORTAL_ENABLED=True

# Production security (config/settings/prod.py). SECRET_KEY and
# ALLOWED_HOSTS are REQUIRED in prod (no defaults - boot fails fast).
# Comma-separated origins with scheme, e.g. https://service.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
# Starter HSTS (1h); raise to 31536000 once HTTPS is proven stable.
DJANGO_SECURE_HSTS_SECONDS=3600
# Optional error reporting; requires sentry-sdk (see requirements.txt)
SENTRY_DSN=

# Database (MySQL 8)
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=erp
DB_HOST=127.0.0.1
DB_PORT=3306
# Seconds a database connection is reused before being reopened. 0 is
# Django's default and means a fresh TCP connect plus MySQL auth
# handshake on EVERY request. Must stay well below MySQL's wait_timeout
# (default 28800). The live connection count is
# GUNICORN_WORKERS x GUNICORN_THREADS plus the Celery worker's
# concurrency - keep it under MySQL max_connections (default 151).
DB_CONN_MAX_AGE=60

# Notifications (NTF-01): comma-separated staff addresses notified on
# every new portal submission. Empty = staff emails are skipped.
STAFF_NOTIFICATION_EMAILS=

# Email (used by prod settings; dev prints emails to the console)
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Cache (POR-04 rate limiting). Local-memory by default. Normally leave
# this alone: setting REDIS_URL below switches the cache to Redis
# automatically. An explicit CACHE_URL still wins, e.g.
# rediscache://127.0.0.1:6379/0
CACHE_URL=locmemcache://

# Redis (optional). EMPTY = no Redis anywhere: local-memory cache,
# database sessions, and background tasks executed inline at the call
# site - exactly how the app behaved before Celery existed, which is why
# dev and CI need no broker. Set it in production to move notification
# e-mail (NTF-05) and thumbnail generation off the request path. Roles
# are split by database index: /0 cache, /1 Celery broker. The instance
# runs maxmemory-policy noeviction because the queue lives there too.
REDIS_URL=
# Override only if the broker is not REDIS_URL's host on database 1.
# CELERY_BROKER_URL=redis://redis:6379/1

# SMTP socket timeout in seconds (production). Bounds the two sends that
# stay synchronous by design: the SVC-17 completion notice and the WNT-03
# expiry-reminder cron.
EMAIL_TIMEOUT=10

# Media serving behind nginx (POR-04 upgrade path). With this on, Django
# does the auth check and nginx streams the file - see the
# /internal-media/ location in docker/nginx.conf.example.
MEDIA_ACCEL_REDIRECT=False
MEDIA_ACCEL_PREFIX=/internal-media/

# Video derivatives (poster frames + browser-playable MP4 copies).
# Needs ffmpeg/ffprobe on PATH - both are in the Docker image. Without
# them each step is a clean logged no-op and the gallery keeps playing
# the original. Blank switches the feature off (that is what the test
# settings do, so the suite and CI never depend on ffmpeg). An absolute
# path works too, e.g. C:\ffmpeg\bin\ffmpeg.exe on Windows.
# The uploaded original is ALWAYS kept - it is the evidentiary record of
# asset damage; the MP4 is an extra file stored beside it.
VIDEO_FFMPEG_BIN=ffmpeg
VIDEO_FFPROBE_BIN=ffprobe
# Kill switch for the expensive half only: False still builds posters.
# Transcoding NEVER runs on a request path. Without REDIS_URL it is
# skipped at upload time and the rows are marked pending; produce the
# copies later with:
#   python manage.py backfill_video_derivatives --limit 20
VIDEO_TRANSCODE_ENABLED=True
# Wall-clock caps (seconds) for the ffprobe/ffmpeg subprocesses, and the
# x264 thread cap so an encode cannot starve gunicorn and MySQL.
# VIDEO_PROBE_TIMEOUT=15
# VIDEO_POSTER_TIMEOUT=30
# VIDEO_TRANSCODE_TIMEOUT=900
# VIDEO_TRANSCODE_THREADS=2

# Gunicorn sizing (docker/gunicorn.conf.py). Concurrency is
# WORKERS x THREADS, not WORKERS: the app runs the gthread worker class
# because it is I/O-bound (MySQL, SMTP, disk, and the client's own
# connection), and a thread costs a stack and a database connection
# rather than a whole Python interpreter. Defaults give 3 x 4 = 12
# concurrent requests; raise THREADS first, WORKERS only if the box has
# CPU headroom (each worker is ~80-120 MB of RSS).
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# Request timeout. Do NOT lower this towards gunicorn's 30 s default
# while MEDIA_ACCEL_REDIRECT is off: Django streams media itself, and a
# 50 MB video to a phone takes longer than 30 s, so the worker would be
# killed mid-download.
# GUNICORN_TIMEOUT=120
# Set to - to enable gunicorn's access log (off by default because nginx
# already logs the same requests).
# GUNICORN_ACCESS_LOG=

# Container startup (docker/entrypoint.sh). The prod compose sets
# MIGRATE=1 on web and 0 on the worker, and COLLECTSTATIC=0 on the
# worker so it never races web on the shared static volume.
DJANGO_MIGRATE_ON_START=0
DJANGO_COLLECTSTATIC=1

# MySQL root password (docker compose only; the prod compose refuses to
# start without it).
MYSQL_ROOT_PASSWORD=root
