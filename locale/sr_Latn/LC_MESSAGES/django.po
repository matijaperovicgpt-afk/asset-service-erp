msgstr "Automatski: jedini sljedeći korak, preduslovi ispunjeni."

#: apps/cases/services.py:1939
#, python-format
msgid ""
"Case #%(id)s is closed ('%(status)s'); it takes no further changes. "
"Attachments may still be added to the case file."
msgstr ""
"Predmet #%(id)s je zatvoren ('%(status)s'); ne prima više izmjene. Prilozi se"
