#: apps/cases/services.py:261
#, python-format
msgid ""
"Cannot move case #%(id)s out of 'diagnostics': the work order needs a "
"diagnostic with the issue, servicing work, parts needed and estimated "
"completion date recorded."
msgstr ""
"Predmet #%(id)s ne može iz 'diagnostics': radni nalog mora imati dijagnostiku"
" sa upisanim kvarom, servisnim radovima, potrebnim djelovima i procijenjenim "
"datumom završetka."

#: apps/cases/services.py:292
#, python-format
msgid ""
"Cannot move case #%(id)s out of 'diagnostics': a first-time client requires a"
" signed full inspection of the asset before a final quote is issued (SVC-08)."
msgstr ""
"Predmet #%(id)s se ne može pomjeriti iz 'diagnostics': za klijenta koji "
"dolazi prvi put potreban je potpisan potpuni pregled uređaja prije izdavanja "
"konačne ponude (SVC-08)."

#: apps/cases/services.py:323
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_progress': no quote exists for the client to "
"approve."
msgstr ""
"Predmet #%(id)s ne može u 'in_progress': ne postoji ponuda koju bi klijent "
"odobrio."

#: apps/cases/services.py:330
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_progress': the latest quote (#%(quote)s) is "
"not accepted (status is '%(status)s')."
msgstr ""
"Predmet #%(id)s ne može u 'in_progress': posljednja ponuda (#%(quote)s) nije "
"prihvaćena (status je '%(status)s')."

#: apps/cases/services.py:338
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_progress': quote #%(quote)s of %(amount)s "
"%(currency)s is missing approval(s): %(levels)s."
msgstr ""
"Predmet #%(id)s ne može u 'in_progress': ponudi #%(quote)s od %(amount)s "
"%(currency)s nedostaju odobrenja: %(levels)s."

#: apps/cases/services.py:367
#, python-format
msgid ""
"Cannot take the direct route to 'in_progress' on case #%(id)s: %(parts)s is "
"not a regular consumable, so the case belongs on the quote path (SVC-10)."
msgstr ""
"Predmet #%(id)s ne može direktno u 'in_progress': %(parts)s nije redovan "
"potrošni dio, pa predmet ide putem ponude (SVC-10)."

#: apps/cases/services.py:375
#, python-format
msgid ""
"Cannot take the direct route to 'in_progress' on case #%(id)s: the store does"
" not hold enough of %(parts)s, so it has to be ordered (SVC-10)."
msgstr ""
"Predmet #%(id)s ne može direktno u 'in_progress': magacin nema dovoljno "
"%(parts)s, pa se mora poručiti (SVC-10)."

#: apps/cases/services.py:383
#, python-format
msgid ""
"Cannot take the direct route to 'in_progress' on case #%(id)s: diagnostic "
"#%(diag)s names parts the catalogue does not know, and an unidentified part "
"cannot be shown to be a consumable in stock. Add them to the catalogue, or "
"take the quote path (SVC-10)."
msgstr ""
"Predmet #%(id)s ne može direktno u 'in_progress': dijagnostika #%(diag)s "
"navodi dijelove koje katalog ne poznaje, a za neidentifikovan dio se ne može "
"dokazati da je potrošni i na stanju. Dodajte ih u katalog ili idite putem "
"ponude (SVC-10)."

#: apps/cases/services.py:440
#, python-format
msgid ""
"Cannot take the direct route to 'in_progress' on case #%(id)s: the estimated "
"parts cost of %(amount)s EUR is above the limit the service may approve on "
"its own and needs %(levels)s approval - quote it to the client instead "
"(SVC-10)."
msgstr ""
"Predmet #%(id)s ne može direktnom rutom u 'in_progress': procijenjena cijena "
"dijelova od %(amount)s EUR je iznad limita koji servis može sam da odobri i "
"traži %(levels)s odobrenje - umjesto toga pošaljite ponudu klijentu (SVC-10)."

#: apps/cases/services.py:469
#, python-format
msgid ""
"Cannot take the direct route to 'in_progress' on case #%(id)s: %(parts)s had "
"to be ordered rather than taken from stock, so the work needs a quote and the"
" client's consent (SVC-10/SVC-11)."
msgstr ""
"Predmet #%(id)s ne može direktnom rutom u 'in_progress': %(parts)s je moralo "
"biti naručeno umjesto uzeto sa stanja, pa radovi traže ponudu i saglasnost "
"klijenta (SVC-10/SVC-11)."

#: apps/cases/services.py:509
#, python-format
msgid "Cannot finish work on case #%(id)s: %(why)s"
msgstr "Radovi na predmetu #%(id)s ne mogu biti završeni: %(why)s"

#: apps/cases/services.py:517
#, python-format
msgid ""
"Cannot finish work on case #%(id)s: nothing authorises the work - there is no"
" fully approved quote and no technician approval limit to fall back on "
"(SVC-14)."
msgstr ""
"Radovi na predmetu #%(id)s ne mogu biti završeni: ništa ne odobrava radove - "
"ne postoji potpuno odobrena ponuda ni tehničarski limit odobravanja kao "
"osnova (SVC-14)."

#: apps/cases/services.py:525
#, python-format
msgid ""
"Cannot finish work on case #%(id)s: the work recorded so far comes to "
"%(spent)s EUR against %(approved)s EUR approved. Additional work must be "
"agreed with the client first - send a new quote (SVC-14)."
msgstr ""
"Radovi na predmetu #%(id)s ne mogu biti završeni: do sada evidentirani radovi"
" iznose %(spent)s EUR naspram odobrenih %(approved)s EUR. Dodatni radovi "
"moraju prethodno biti dogovoreni sa klijentom - pošaljite novu ponudu "
"(SVC-14)."

#: apps/cases/services.py:548
#, python-format
msgid ""
"Cannot move case #%(id)s to 'awaiting_part': no open part order with an "
"expected delivery date."
msgstr ""
"Predmet #%(id)s ne može u 'awaiting_part': nema otvorene porudžbine dijela sa"
" očekivanim datumom isporuke."

#: apps/cases/services.py:560
#, python-format
msgid ""
"Cannot move case #%(id)s to 'awaiting_part': part order(s) %(orders)s are for"
" non-stock parts without a linked 50%% advance payment."
msgstr ""
"Predmet #%(id)s ne može u 'awaiting_part': porudžbine %(orders)s su za "
"djelove van zaliha bez povezanog avansa od 50%%."

#: apps/cases/services.py:580
#, python-format
msgid ""
"Cannot move case #%(id)s to 'ready_for_handover': no quality-control test run"
" recorded."
msgstr ""
"Predmet #%(id)s ne može u 'ready_for_handover': nije zabilježen nijedan "
"kontrolni test."

#: apps/cases/services.py:587
#, python-format
msgid ""
"Cannot move case #%(id)s to 'ready_for_handover': the latest test run "
"(#%(run)s) did not pass."
msgstr ""
"Predmet #%(id)s ne može u 'ready_for_handover': posljednji test (#%(run)s) "
"nije prošao."

#: apps/cases/services.py:661
msgid "the transport inquiry"
msgstr "upit za transport"

#: apps/cases/services.py:665
#, python-format
msgid ""
"Cannot move case #%(id)s to 'quote_sent': the inquiry is incomplete - missing"
" %(missing)s. The offer is built on it (TRP-01)."
msgstr ""
"Slučaj #%(id)s ne može u 'ponuda poslata': upit je nepotpun - nedostaje "
"%(missing)s. Ponuda se pravi na osnovu njega (TRP-01)."

#: apps/cases/services.py:679
#, python-format
msgid ""
"Cannot move case #%(id)s to 'quote_sent': no offer has been sent - a quote "
"stating the scope of service and the estimated cost is issued before the "
"transport is organized (TRP-01)."
msgstr ""
"Slučaj #%(id)s ne može u 'ponuda poslata': nijedna ponuda nije poslata - "
"ponuda sa obimom usluge i procijenjenim troškovima izdaje se prije "
"organizacije transporta (TRP-01)."

#: apps/cases/services.py:708
#, python-format
msgid ""
"Cannot move case #%(id)s to 'advance_paid': no advance payment exists yet - "
"it is derived from the offer when the offer is sent (TRP-04)."
msgstr ""
"Slučaj #%(id)s ne može u 'avans plaćen': avans još ne postoji - izvodi se iz "
"ponude kada se ponuda pošalje (TRP-04)."

#: apps/cases/services.py:716
#, python-format
msgid ""
"Cannot move case #%(id)s to 'advance_paid': the advance has not been marked "
"paid yet (TRP-04)."
msgstr ""
"Predmet #%(id)s ne može preći u 'advance_paid': avans još nije označen kao "
"uplaćen (TRP-04)."

#: apps/cases/services.py:745
#, python-format
msgid ""
"Cannot move case #%(id)s to 'departure_scheduled': no paid advance payment "
"recorded (paid_at set)."
msgstr ""
"Predmet #%(id)s ne može u 'departure_scheduled': nema evidentiranog plaćenog "
"avansa (paid_at postavljen)."

#: apps/cases/services.py:786
#, python-format
msgid ""
"Cannot move case #%(id)s to 'departure_scheduled': the advance paid is "
"%(paid)s of the %(required)s that 50%% of the offer comes to - the vehicle, "
"driver and crane are reserved against the full advance (TRP-04)."
msgstr ""
"Slučaj #%(id)s ne može u 'polazak zakazan': plaćeni avans je %(paid)s od "
"%(required)s koliko iznosi 50%% ponude - vozilo, vozač i dizalica rezervišu "
"se na osnovu punog avansa (TRP-04)."

#: apps/cases/services.py:817
#, python-format
msgid ""
"Cannot move case #%(id)s to 'departure_scheduled': no departure date has been"
" agreed or booked yet (TRP-05)."
msgstr ""
"Predmet #%(id)s ne može preći u 'departure_scheduled': datum polaska još nije"
" dogovoren niti zakazan (TRP-05)."

#: apps/cases/services.py:859
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_transit': missing a signed pre-transport "
"intake record - it must be made before loading (TRP-06)."
msgstr ""
"Predmet #%(id)s ne može preći u 'in_transit': nedostaje potpisan prijemni "
"zapisnik prije transporta - mora se sačiniti prije utovara (TRP-06)."

#: apps/cases/services.py:879
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_transit': the loading and unloading plan is "
"not agreed - missing %(missing)s (TRP-02)."
msgstr ""
"Slučaj #%(id)s ne može u 'u prevozu': plan utovara i istovara nije dogovoren "
"- nedostaje %(missing)s (TRP-02)."

#: apps/cases/services.py:897
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_transit': the loading has not been confirmed "
"ready for the road (TRP-07)."
msgstr ""
"Predmet #%(id)s ne može preći u 'in_transit': utovar još nije potvrđen kao "
"spreman za put (TRP-07)."

#: apps/cases/services.py:915
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_transit': the departure is booked for "
"%(date)s, which is still ahead."
msgstr ""
"Predmet #%(id)s ne može preći u 'in_transit': polazak je zakazan za %(date)s,"
" što je još pred nama."

#: apps/cases/services.py:949
#, python-format
msgid ""
"Cannot move case #%(id)s to 'departure_scheduled': this asset goes with a "
"specialized carrier, whose own offer is obtained before the transport is "
"organized - declare the carrier's price first (TRP-03)."
msgstr ""
"Predmet #%(id)s ne može u 'departure_scheduled': ovaj uređaj prevozi "
"specijalizovani prevoznik, od koga se pribavlja posebna ponuda prije "
"organizacije transporta - prvo unesite cijenu prevoznika (TRP-03)."

#: apps/cases/services.py:976
#, python-format
msgid ""
"Cannot move case #%(id)s to 'delivered': missing the delivery confirmation - "
"record the delivery protocol first (TRP-08)."
msgstr ""
"Predmet #%(id)s ne može preći u 'delivered': nedostaje potvrda isporuke - "
"prvo evidentirajte zapisnik o isporuci (TRP-08)."

#: apps/cases/services.py:1012
msgid "a client contact (phone or e-mail)"
msgstr "kontakt klijenta (telefon ili e-mail)"

#: apps/cases/services.py:1015
