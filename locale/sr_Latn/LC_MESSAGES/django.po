msgstr "smještaj (otvoreni plac ili hala)"

#: apps/cases/services.py:1026
msgid "the storage term (daily, monthly or seasonal)"
msgstr "period skladištenja (dnevni, mjesečni ili sezonski)"

#: apps/cases/services.py:1028
msgid "the site the asset is coming from"
msgstr "lokacija sa koje uređaj dolazi"

#: apps/cases/services.py:1030
msgid "the ownership of the asset"
msgstr "vlasništvo nad uređajem"

#: apps/cases/services.py:1032
msgid "at least one selected service"
msgstr "bar jedna izabrana usluga"

#: apps/cases/services.py:1037
#, python-format
msgid "Cannot move case #%(id)s to 'contracted': missing %(missing)s (WNT-01)."
msgstr ""
"Predmet #%(id)s ne može preći u 'ugovoreno': nedostaje %(missing)s (WNT-01)."

#: apps/cases/services.py:1065
#, python-format
msgid ""
"Cannot move case #%(id)s to 'estimate_sent': no value estimate has been sent "
"to the client yet (WNT-03)."
msgstr ""
"Predmet #%(id)s ne može preći u 'procjena poslata': klijentu još nije poslata"
" procjena vrijednosti (WNT-03)."

#: apps/cases/services.py:1084
#, python-format
msgid ""
"Cannot move case #%(id)s to 'in_storage': the asset has not been placed on "
"the yard or in the hall yet (WNT-05)."
msgstr ""
"Predmet #%(id)s ne može preći u 'in_storage': uređaj još nije smješten u "
"skladište ni u halu (WNT-05)."

#: apps/cases/services.py:1111
msgid "a signed handover record (signed_at set)"
msgstr "potpisan zapisnik o predaji (signed_at postavljen)"

#: apps/cases/services.py:1114
msgid "financial settlement (financially_settled=True)"
msgstr "finansijsko izmirenje (financially_settled=True)"

#: apps/cases/services.py:1118
#, python-format
msgid "Cannot move case #%(id)s to 'closed': missing %(missing)s."
msgstr "Predmet #%(id)s ne može u 'closed': nedostaje %(missing)s."

#: apps/cases/services.py:1144
msgid "Choose how the asset reaches the yard (SVC-04)."
msgstr "Izaberite način dopreme uređaja do skladišta (SVC-04)."

#: apps/cases/services.py:1150
#, python-format
msgid ""
"Case #%(id)s is worked where the asset lies, so nothing is delivered anywhere"
" - change the work location first if the asset is coming in after all "
"(SVC-03/SVC-04)."
msgstr ""
"Predmet #%(id)s se radi tamo gdje se uređaj nalazi, pa se ništa nigdje ne "
"doprema - prvo promijenite mjesto izvođenja radova ako uređaj ipak dolazi "
"(SVC-03/SVC-04)."

#: apps/cases/services.py:1249
#, python-format
msgid "Unknown contact role: %(role)s."
msgstr "Nepoznata uloga kontakta: %(role)s."

#: apps/cases/services.py:1278
#, python-format
msgid "'%(email)s' is not a valid e-mail address (§7.1)."
msgstr "'%(email)s' nije ispravna e-mail adresa (§7.1)."

#: apps/cases/services.py:1292
msgid ""
"This case has no client linked yet, so the owner cannot be the contact - "
"match the client at triage first (§7.1)."
msgstr ""
"Ovaj slučaj još nema povezanog klijenta, pa vlasnik ne može biti kontakt - "
"prvo povežite klijenta u trijaži (§7.1)."

#: apps/cases/services.py:1299
#, python-format
msgid ""
"%(client)s has neither a phone number nor an e-mail address on file, so "
"nothing could be sent there (§7.1)."
msgstr ""
"%(client)s nema evidentiran ni broj telefona ni e-mail adresu, pa se tamo "
"ništa ne bi moglo poslati (§7.1)."

#: apps/cases/services.py:1307
msgid ""
"The report does not say who made it, so the reporter cannot be the contact "
"(§7.1)."
msgstr ""
"Prijava ne navodi ko ju je podnio, pa podnosilac ne može biti kontakt (§7.1)."

#: apps/cases/services.py:1314
msgid ""
"The report carries neither a phone number nor an e-mail address for its "
"reporter (§7.1)."
msgstr "Prijava ne sadrži ni broj telefona ni e-mail adresu podnosioca (§7.1)."

#: apps/cases/services.py:1433
#, python-format
msgid ""
"What the client thinks is wrong is a service question - case #%(id)s is a "
"%(kind)s case and reports no fault (SVC-01)."
msgstr ""
"Šta klijent misli da je kvar jeste servisno pitanje - slučaj #%(id)s je "
"%(kind)s i ne prijavljuje kvar (SVC-01)."

#: apps/cases/services.py:1443
msgid ""
"Either write down what the client thinks is wrong, or record that they had no"
" view - not both (SVC-01)."
msgstr ""
"Ili zapišite šta klijent misli da je kvar, ili zabilježite da nije imao "
"mišljenje - ne oboje (SVC-01)."

#: apps/cases/services.py:1450
msgid ""
"Record what the client thinks is wrong, or tick that they had no view "
"(SVC-01)."
msgstr ""
"Zabilježite šta klijent misli da je kvar, ili označite da nije imao mišljenje"
" (SVC-01)."

#: apps/cases/services.py:1514
#, python-format
msgid ""
"Where the work is carried out is a service question - case #%(id)s is a "
"%(kind)s case, and its asset is taken in either way (SVC-03)."
msgstr ""
"Mjesto izvođenja radova je servisno pitanje - predmet #%(id)s je %(kind)s "
"predmet, a njegov uređaj se svakako preuzima (SVC-03)."

#: apps/cases/services.py:1522
msgid "Choose where the work is carried out (SVC-03)."
msgstr "Izaberite gdje se radovi izvode (SVC-03)."

#: apps/cases/services.py:1533
#, python-format
msgid ""
"Case #%(id)s already has a signed intake record - the asset was received, so "
"the work cannot be recorded as done where it lies (SVC-03/SVC-06)."
msgstr ""
"Predmet #%(id)s već ima potpisan prijemni zapisnik - uređaj je primljen, pa "
"se radovi ne mogu evidentirati kao izvedeni tamo gdje se uređaj nalazi "
"(SVC-03/SVC-06)."

#: apps/cases/services.py:1586
#, python-format
msgid ""
"Cannot start diagnostics on case #%(id)s: nothing describes what the asset is"
" doing (SVC-01)."
msgstr ""
"Dijagnostika za predmet #%(id)s ne može početi: ništa ne opisuje šta se sa "
"uređajem dešava (SVC-01)."

#: apps/cases/services.py:1593
#, python-format
msgid ""
"Cannot start diagnostics on case #%(id)s: the client has not been asked what "
"they think is wrong - record their assessment, or that they had none "
"(SVC-01)."
msgstr ""
"Dijagnostika za slučaj #%(id)s ne može početi: klijent nije upitan šta misli "
"da je kvar - zabilježite njegovu procjenu, ili da je nije imao (SVC-01)."

