msgstr "uređaj povezan sa predmetom (dužina određuje cijenu skladištenja)"

#: apps/cases/services.py:1020
msgid "the permit number on the storage agreement"
msgstr "broj dozvole na ugovoru o skladištenju"

#: apps/cases/services.py:1022
