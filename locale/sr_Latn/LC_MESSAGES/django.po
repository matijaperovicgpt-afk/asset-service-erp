msgstr ""
"Prelaz iz '%(from)s' u '%(to)s' nije dozvoljen za tip predmeta '%(type)s'."

#: apps/cases/services.py:1722
#, python-format
msgid ""
"Cannot move case #%(id)s from '%(from)s' to '%(to)s': role '%(role)s' is not "
