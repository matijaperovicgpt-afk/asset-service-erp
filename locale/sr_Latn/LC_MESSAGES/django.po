#, python-format
msgid ""
"Cannot move case #%(id)s to 'intake_scheduled': the work is done where the "
"asset lies, so it needs an agreed on-site visit (Appointment with "
"kind=ON_SITE_VISIT)."
msgstr ""
"Predmet #%(id)s ne može u status 'intake_scheduled': radovi se izvode tamo "
"gdje se uređaj nalazi, pa je potreban dogovoren izlazak na teren (Appointment"
" sa kind=ON_SITE_VISIT)."

#: apps/cases/services.py:99
#, python-format
msgid ""
"Cannot move case #%(id)s to 'intake_scheduled': missing an intake appointment"
" (Appointment with kind=INTAKE)."
msgstr ""
"Predmet #%(id)s ne može u 'intake_scheduled': nedostaje termin prijema "
"(Appointment sa kind=INTAKE)."

#: apps/cases/services.py:110
#, python-format
msgid ""
"Cannot move case #%(id)s to 'intake_scheduled': nobody has said who we "
"contact about it - the reporter, the owner, or somebody else (§7.1)."
msgstr ""
"Slučaj #%(id)s ne može u 'zakazan prijem': niko nije rekao koga kontaktiramo "
"u vezi s njim - podnosioca, vlasnika ili nekog drugog (§7.1)."

#: apps/cases/services.py:121
#, python-format
msgid ""
"Cannot move case #%(id)s to 'intake_scheduled': nobody has recorded where the"
" asset is (§7.3)."
msgstr ""
"Predmet #%(id)s ne može u status 'intake_scheduled': niko nije zabilježio "
"gdje se uređaj nalazi (§7.3)."

#: apps/cases/services.py:132
#, python-format
msgid ""
"Cannot move case #%(id)s to 'intake_scheduled': the way the asset gets here "
"has not been agreed - the date and the delivery method are settled in the "
"same conversation (SVC-04)."
msgstr ""
"Predmet #%(id)s ne može u status 'intake_scheduled': način dopreme uređaja "
"nije dogovoren - datum i način dopreme dogovaraju se u istom razgovoru "
"(SVC-04)."

