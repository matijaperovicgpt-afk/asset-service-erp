#: apps/parts/services.py:142
#, python-format
msgid ""
"Part '%(code)s' cannot be deleted: it is referenced by %(orders)s part "
"order(s), %(used)s work-order installation(s) and %(needed)s diagnostic(s), "
"which are case history (INV-03). There is no way to retire a part yet - do "
"not clear 'consumable' or zero the stock to fake one, that changes how its "
"open orders are treated (SVC-10/SVC-11) and still leaves the part orderable."
msgstr ""
"Dio '%(code)s' se ne može obrisati: referenciran je iz %(orders)s porudžbina "
