#: apps/intake/services.py:89 apps/intake/services.py:493
#, python-format
msgid ""
"Intake record #%(id)s is signed and final; its inventory can no longer be "
"changed (SVC-06)."
msgstr ""
"Prijemnica #%(id)s je potpisana i konačna; njen inventar se više ne može "
"mijenjati (SVC-06)."

#: apps/intake/services.py:96
#, python-format
msgid ""
"Intake record #%(id)s lists items, so 'nothing received' cannot also be true "
"- remove them first (SVC-06)."
msgstr ""
"Prijemnica #%(id)s sadrži popisane stavke, pa 'ništa nije primljeno' ne može "
"istovremeno biti tačno - prvo ih uklonite (SVC-06)."

#: apps/intake/services.py:267
msgid "A staff user is required to sign the handover record (SVC-18)."
msgstr ""
"Za potpisivanje zapisnika o predaji potreban je zaposleni korisnik (SVC-18)."

#: apps/intake/services.py:274
msgid ""
"The handover is signed by the responsible worker - a technician or a manager "
"(SVC-18)."
msgstr ""
"Zapisnik o predaji potpisuje odgovorni radnik - tehničar ili menadžer "
"(SVC-18)."

#: apps/intake/services.py:281
#, python-format
msgid ""
"Handover record #%(id)s is already confirmed by the client and final "
"(SVC-18)."
msgstr ""
"Zapisnik o predaji #%(id)s je već potvrđen od strane klijenta i konačan je "
"(SVC-18)."

#: apps/intake/services.py:288
#, python-format
msgid ""
"Handover record #%(id)s was already signed by the worker at %(when)s and "
"cannot be re-signed (SVC-18)."
msgstr ""
"Zapisnik o predaji #%(id)s je radnik već potpisao %(when)s i ne može se "
"ponovo potpisati (SVC-18)."

#: apps/intake/services.py:348
msgid "Open the work order before creating the intake record (SVC-02/SVC-06)."
msgstr "Otvorite radni nalog prije kreiranja prijemnice (SVC-02/SVC-06)."

#: apps/intake/services.py:359
#, python-format
msgid ""
"Case #%(id)s is worked where the asset lies, so no intake record is made for "
"it (SVC-03)."
msgstr ""
"Na predmetu #%(id)s radi se tamo gdje se uređaj nalazi, pa se za njega ne "
"pravi prijemni zapisnik (SVC-03)."

#: apps/intake/services.py:369
msgid "Record whether the asset stays on its mount or is taken off (SVC-06)."
msgstr ""
"Evidentirajte da li uređaj ostaje na postolju ili se skida sa njega (SVC-06)."

#: apps/intake/services.py:376
msgid ""
"Record whether the asset arrived clean or was washed on arrival - the photos "
"are read against it (SVC-07)."
msgstr ""
"Evidentirajte da li je uređaj stigao čist ili je očišćen pri dolasku - "
"fotografije se čitaju u odnosu na to (SVC-07)."

#: apps/intake/services.py:386
msgid ""
"The asset is taken off its mount, so record where it will be stored (SVC-06)."
msgstr ""
"Uređaj se skida sa postolja, pa evidentirajte gdje će biti smješten (SVC-06)."

#: apps/intake/services.py:392
#, python-format
msgid "Unknown fuel level '%(level)s' (SVC-06)."
msgstr "Nepoznat nivo goriva '%(level)s' (SVC-06)."

#: apps/intake/services.py:397
msgid ""
"Describe the visible damage and issues observed on arrival - write 'none' "
"when the asset is undamaged (SVC-07)."
msgstr ""
"Opišite vidljiva oštećenja i probleme uočene po dolasku - upišite 'nema' ako "
"je uređaj neoštećen (SVC-07)."

#: apps/intake/services.py:409
#, python-format
msgid ""
"Case #%(id)s already has an unsigned intake record (#%(record)s); sign it "
"instead of creating another (SVC-06)."
msgstr ""
"Predmet #%(id)s već ima nepotpisanu prijemnicu (#%(record)s); potpišite nju "
"umjesto kreiranja nove (SVC-06)."

#: apps/intake/services.py:451
#, python-format
msgid ""
"Intake record #%(id)s is signed and final; record later-discovered items as "
"an amendment (SVC-07)."
msgstr ""
"Prijemnica #%(id)s je potpisana i konačna; naknadno pronađene stvari "
"evidentirajte kao dopunu (SVC-07)."

#: apps/intake/services.py:457
#, python-format
msgid "Unknown item category '%(category)s' (SVC-06)."
msgstr "Nepoznata kategorija stavke '%(category)s' (SVC-06)."

#: apps/intake/services.py:461
msgid "An item name is required (SVC-06)."
msgstr "Naziv stavke je obavezan (SVC-06)."

#: apps/intake/services.py:463
msgid "Item quantity must be at least 1 (SVC-06)."
msgstr "Količina stavke mora biti najmanje 1 (SVC-06)."

#: apps/intake/services.py:531
#, python-format
msgid ""
"Case #%(id)s has no asset record yet - match or create one at triage before "
"signing for the asset (§7.2)."
msgstr ""
"Predmet #%(id)s još nema zapis o uređaju - povežite ili kreirajte ga u "
"trijaži prije potpisivanja prijema uređaja (§7.2)."

#: apps/intake/services.py:539
#, python-format
msgid ""
"Asset '%(asset)s' is not fully identified - %(missing)s still missing. A "
"receipt has to say which asset it is for (§7.2)."
msgstr ""
"Uređaj '%(asset)s' nije potpuno identifikovan - nedostaje %(missing)s. "
"Potvrda o prijemu mora reći za koji uređaj je izdata (§7.2)."

#: apps/intake/services.py:562
msgid "A staff user is required to sign the intake record (SVC-06)."
msgstr "Za potpisivanje prijemnice potreban je zaposleni korisnik (SVC-06)."

#: apps/intake/services.py:567
#, python-format
msgid ""
"Intake record #%(id)s was already signed at %(when)s and cannot be re-signed "
"(SVC-06)."
msgstr ""
"Prijemnica #%(id)s je već potpisana %(when)s i ne može se ponovo potpisati "
"(SVC-06)."

#: apps/intake/services.py:584
msgid ""
"Photograph the asset on arrival (wash it first if dirty) and upload at least "
"one intake photo before confirming receipt (SVC-07)."
msgstr ""
"Fotografišite uređaj po dolasku (očistite ga prvo ako je prljav) i priložite "
"bar jednu fotografiju prijema prije potvrde prijema (SVC-07)."

#: apps/intake/services.py:598
msgid ""
"Read the fuel gauge before confirming receipt, or record that the asset has "
"no tank (§7.6)."
msgstr ""
"Očitajte nivo goriva prije potvrde prijema, ili zabilježite da uređaj nema "
"rezervoar (§7.6)."

#: apps/intake/services.py:607
msgid ""
"List the personal items, equipment, keys and documents received with the "
"asset, or state explicitly that nothing was received (SVC-06)."
msgstr ""
"Popišite lične stvari, opremu, ključeve i dokumentaciju primljene uz uređaj, "
"ili izričito navedite da ništa nije primljeno (SVC-06)."

#: apps/intake/services.py:653
#, python-format
msgid ""
"Case #%(id)s has no delivery protocol yet - the handover record is drawn up "
"after the asset is delivered, not before (TRP-09)."
msgstr ""
"Predmet #%(id)s još nema zapisnik o isporuci - zapisnik o predaji se pravi "
"poslije isporuke uređaja, ne prije (TRP-09)."

#: apps/intake/services.py:687
#, python-format
msgid ""
"Case #%(id)s has no work order signed by the responsible technician yet - the"
" handover record is drawn up once the work is finished, not before (SVC-18)."
msgstr ""
"Predmet #%(id)s još nema radni nalog potpisan od odgovornog tehničara - "
"zapisnik o predaji se sastavlja kada su radovi završeni, a ne prije (SVC-18)."

#: apps/intake/services.py:714
#, python-format
msgid ""
"Case #%(id)s already has an unsigned handover record (#%(record)s); sign it "
"or record discrepancies on it instead of creating another (SVC-18)."
msgstr ""
"Predmet #%(id)s već ima nepotpisan zapisnik o predaji (#%(record)s); "
"potpišite ga ili zabilježite odstupanja na njemu umjesto kreiranja novog "
"(SVC-18)."

#: apps/intake/services.py:748
#, python-format
msgid ""
"Handover record #%(id)s is signed and final; its discrepancies note can no "
"longer be edited (SVC-18)."
msgstr ""
"Zapisnik o predaji #%(id)s je potpisan i konačan; napomena o odstupanjima se "
"više ne može mijenjati (SVC-18)."

#: apps/intake/services.py:778
#, python-format
msgid ""
"Handover record #%(id)s was already signed at %(when)s and cannot be re-"
"signed (SVC-18)."
msgstr ""
"Zapisnik o predaji #%(id)s je već potpisan %(when)s i ne može se ponovo "
"potpisati (SVC-18)."

#: apps/intake/services.py:786
msgid ""
"Photograph the asset as it is handed over before confirming receipt - the "
"intake photos have nothing to be compared against otherwise (SVC-07/SVC-18)."
msgstr ""
"Fotografišite uređaj pri predaji prije potvrde prijema - inače fotografije sa"
" prijema nemaju sa čim da se uporede (SVC-07/SVC-18)."

#: apps/intake/services.py:794
#, python-format
msgid ""
"Handover record #%(id)s is not signed by the responsible worker yet; the "
"worker approves the comparison first (SVC-18)."
msgstr ""
"Zapisnik o predaji #%(id)s još nije potpisan od odgovornog radnika; radnik "
"prvo odobrava poređenje (SVC-18)."

#: apps/intake/services.py:802
#, python-format
msgid ""
"Handover record #%(id)s has no client-signed approval scan attached; upload "
"the signed document first (SVC-18)."
msgstr ""
"Zapisnik o predaji #%(id)s nema priložen sken saglasnosti potpisan od "
"klijenta; prvo otpremite potpisani dokument (SVC-18)."

